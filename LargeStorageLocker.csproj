<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The game's own assemblies (0Harmony, Assembly-CSharp) are built against .NET Framework 4.8.
         Targeting 4.7.2 makes MSBuild refuse to resolve them (MSB3274/MSB3275), so the csproj build
         needs 4.8 to match. build.ps1 is unaffected either way. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>LargeStorageLocker</AssemblyName>
    <RootNamespace>LargeStorageLocker</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <OniManagedDir>D:\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</OniManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(OniManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(OniManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(OniManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(OniManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
